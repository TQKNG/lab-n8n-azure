# n8n Environment Configuration
# Generated from template during deployment

# ============================================================================
# Basic Configuration
# ============================================================================

# Domain where n8n is accessible
N8N_HOST={{DOMAIN_NAME}}

# Port n8n runs on (internal)
N8N_PORT=5678

# Protocol (http or https)
N8N_PROTOCOL=https

# Node environment
NODE_ENV=production

# ============================================================================
# Webhook Configuration
# ============================================================================

# Webhook URL
WEBHOOK_URL=https://{{DOMAIN_NAME}}/

# ============================================================================
# Security
# ============================================================================

# Encryption key for credentials (REQUIRED - 32+ characters)
N8N_ENCRYPTION_KEY={{ENCRYPTION_KEY}}

# Basic auth (optional - for additional security layer)
# N8N_BASIC_AUTH_ACTIVE=true
# N8N_BASIC_AUTH_USER=admin
# N8N_BASIC_AUTH_PASSWORD=your-password-here

# ============================================================================
# Execution Settings
# ============================================================================

# Execution process (main or own)
EXECUTIONS_PROCESS=main

# Execution mode (regular or queue)
EXECUTIONS_MODE=regular

# Execution timeout (seconds)
EXECUTIONS_TIMEOUT=300
EXECUTIONS_TIMEOUT_MAX=3600

# ============================================================================
# Data Retention
# ============================================================================

# Prune execution data
EXECUTIONS_DATA_PRUNE=true

# Max age of execution data (hours)
EXECUTIONS_DATA_MAX_AGE=336

# Save execution data
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_SAVE_ON_SUCCESS=all
EXECUTIONS_DATA_SAVE_MANUAL_EXECUTIONS=true

# ============================================================================
# Performance
# ============================================================================

# Max payload size (MB)
N8N_PAYLOAD_SIZE_MAX=16

# Metrics collection
N8N_METRICS=false

# Anonymous usage statistics
N8N_DIAGNOSTICS_ENABLED=false

# ============================================================================
# Timezone
# ============================================================================

GENERIC_TIMEZONE=UTC
TZ=UTC

# ============================================================================
# Logging
# ============================================================================

# Log level (error, warn, info, verbose, debug)
N8N_LOG_LEVEL=info

# Log output (console, file, or both)
N8N_LOG_OUTPUT=console,file

# Log file location
N8N_LOG_FILE_LOCATION=/home/node/.n8n/logs/

# ============================================================================
# Database (Optional - PostgreSQL)
# ============================================================================

# Uncomment to use PostgreSQL instead of SQLite
# DB_TYPE=postgresdb
# DB_POSTGRESDB_HOST=postgres
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=n8n
# DB_POSTGRESDB_USER=n8n
# DB_POSTGRESDB_PASSWORD={{POSTGRES_PASSWORD}}

# ============================================================================
# Email (SMTP) - Optional
# ============================================================================

# N8N_EMAIL_MODE=smtp
# N8N_SMTP_HOST=smtp.gmail.com
# N8N_SMTP_PORT=587
# N8N_SMTP_USER=your-email@gmail.com
# N8N_SMTP_PASS=your-app-password
# N8N_SMTP_SENDER=your-email@gmail.com

# ============================================================================
# External Hooks - Optional
# ============================================================================

# N8N_EXTERNAL_HOOK_FILES=/home/node/.n8n/hooks/hook.js

# ============================================================================
# Version Configuration
# ============================================================================

N8N_VERSION={{N8N_VERSION}}
DEPLOYMENT_ENV={{ENVIRONMENT}}